# CareFlow Backend Production Environment Variables Example
# Copy to environment or system env variables for production deployment

DATABASE_URL=jdbc:mysql://localhost:3306/careflow_db?useSSL=false&serverTimezone=UTC
DATABASE_USERNAME=root
DATABASE_PASSWORD=YOUR_PRODUCTION_DATABASE_PASSWORD
JWT_SECRET=GENERATE_A_SECURE_SECRET_MIN_256_BITS
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
CORS_ALLOWED_ORIGINS=https://your-careflow-production-domain.com
